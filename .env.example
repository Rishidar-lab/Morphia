# MORPHIA Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to source control.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://morphia:morphia_dev@localhost:5432/morphia
DATABASE_URL_SYNC=postgresql://morphia:morphia_dev@localhost:5432/morphia

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth ──────────────────────────────────────────────────
# Password hashing rounds (higher = slower but more secure)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
# Session lifetime in hours
SESSION_LIFETIME_HOURS=24
# Rate limiting
AUTH_RATE_LIMIT=30/minute
WORKER_AUTH_RATE_LIMIT=60/minute

# ── Storage (S3-compatible) ───────────────────────────────
# For local dev, uses filesystem at STORAGE_LOCAL_PATH
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# For S3-compatible:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_BUCKET_NAME=morphia-evidence
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# ── AI Provider (all optional, mock used if absent) ───────
# MORPHIA_PROVIDER=mock            # mock | openai | openrouter | local — overrides auto-selection
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# LOCAL_MODEL_URL=http://localhost:11434/v1
# LOCAL_MODEL_NAME=llama3.1

# ── Worker ────────────────────────────────────────────────
WORKER_AUTH_SECRET=change-me-to-a-random-secret
WORKER_HEARTBEAT_INTERVAL=30
WORKER_MAX_RETRIES=3
# Where the worker reaches the API. docker-compose overrides this to
# http://api:8000 for the worker container; only needed here for
# `make dev-worker` running the worker directly on the host.
API_BASE_URL=http://localhost:8000

# ── Seeding / testing (NEVER set in production) ────────────
# Seed refuses to run unless an explicit password is supplied.
# SEED_ADMIN_EMAIL=admin@morphia.local
# SEED_ADMIN_PASSWORD=generate-a-unique-local-password
# SEED_ADMIN_DISPLAY_NAME=MORPHIA Admin
# ENABLE_E2E_AUTH_OVERRIDE=true
# TEST_OWNER_EMAIL=test@morphia.local
